<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Top Bar: Hint Button, Coins Pill, Hard Timer (when visible), Hamburger Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_hint"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="86dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_btn_blue"
            android:contentDescription="@string/cd_use_hint"
            android:text="💡(0)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_coin_pill"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_coin_pill"
            android:contentDescription="@string/cd_coin_balance"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="⭐ 213"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_timer_pill"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_coin_pill"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="⏱ 02:00"
            android:textColor="#FF6B6B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_hamburger"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_blue"
            android:contentDescription="@string/cd_open_menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_hamburger" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="GENERAL - Level 1"
        android:textColor="@color/white"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- Scrollable content area so smaller screens never clip word chips or buttons -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 10x10 Board -->
            <FrameLayout
                android:id="@+id/board_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_board_container"
                android:padding="4dp">

                <com.example.ui.WordGridView
                    android:id="@+id/word_grid_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <!-- Word List Chips -->
            <com.example.ui.WordFlowLayout
                android:id="@+id/word_flow_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_blue"
            android:text="@string/btn_back"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_level"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_blue"
            android:text="@string/btn_clear_level"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
